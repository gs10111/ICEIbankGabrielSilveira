# Copie para .env e ajuste. O compose le .env automaticamente.
# Tudo aqui tem default no docker-compose.yml: sem .env, o projeto sobe igual.

# Broker. Sem esta linha, o compose usa o RabbitMQ que ele mesmo sobe.
# Para usar CloudAMQP, descomente e ponha a sua URL:
# RABBITMQ_URL=amqps://usuario:senha@host.cloudamqp.com/vhost

# Credenciais do RabbitMQ local (painel em http://localhost:15672)
# RABBITMQ_USER=guest
# RABBITMQ_PASS=guest

# Segredos da aplicacao — TROQUE em qualquer coisa que nao seja a sua maquina.
# JWT_SEGREDO=troque-este-segredo-por-algo-com-mais-de-32-caracteres
# AGENCIA_TOKEN=troque-este-token-de-servico
